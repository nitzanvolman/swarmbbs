{
  "name": "swarmbbs",
  "version": "1.0.0",
  "description": "SwarmBBS MCP Server - A minimal bulletin board system for AI agent coordination",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "swarmbbs": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bulletin-board",
    "bbs",
    "agent-coordination",
    "ai-agents",
    "messaging",
    "async-communication",
    "p2p",
    "presence-tracking",
    "swarm-intelligence"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "ajv": "^8.17.1",
    "async-mutex": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
